        "to": "repair_proposed",
        "condition_code": "diagnostic_challenge_resolved"
      },
      {
        "from": "challenged",
        "to": "quarantined",
        "condition_code": "diagnostic_challenge_unresolved"
      },
      {
        "from": "repair_proposed",
        "to": "verifying",
        "condition_code": "verification_request_precommitted"
      },
      {
        "from": "repair_proposed",
        "to": "rejected",
        "condition_code": "repair_critic_rejected"
      },
      {
        "from": "verifying",
        "to": "rejected",
        "condition_code": "gate_rejected"
      },
      {
        "from": "verifying",
        "to": "quarantined",
        "condition_code": "gate_inconclusive"
      },
      {
        "from": "verifying",
        "to": "probation",
        "condition_code": "gate_candidate"
      },
      {
        "from": "verifying",
        "to": "promoted",
        "condition_code": "gate_adopted"
      },
      {
        "from": "probation",
        "to": "rejected",
        "condition_code": "fresh_batch_gate_rejected"
      },
      {
        "from": "probation",
        "to": "quarantined",
        "condition_code": "fresh_batch_gate_inconclusive"
      },
      {
        "from": "probation",
        "to": "promoted",
        "condition_code": "fresh_batch_gate_adopted"
      },
      {
        "from": "promoted",
        "to": "rolled_back",
        "condition_code": "new_blocking_regression"
      },
      {
        "from": "promoted",
        "to": "deprecated",
        "condition_code": "superseded_by_promoted_artifact"
      }
    ],
    "taxonomy_change_scope": {
