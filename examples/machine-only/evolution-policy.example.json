  "policy": {
    "id": "policy.machine-only.v1",
    "version": "2.0.0-alpha.1",
    "status": "promoted",
    "thresholds": {
      "min_independent_judges": 2,
      "min_evidence_coverage": 0.9,
      "min_counterfactual_pass_rate": 0.9,
      "max_regression_failure_rate": 0.05,
      "min_repeat_runs": 2
    },
    "prohibit_generator_as_judge": true,
    "require_order_swap": true,
    "require_candidate_preferred": true,
    "require_blind_candidate_identity": true,
    "require_blind_model_identity": true,
    "require_no_unresolved_blocking_challenges": true,
    "promotion_targets": [
      "repair_case"
    ]
  },
  "actor_isolation": {
    "logical_roles": [
      "generator",
      "contract_critic",
      "critic",
      "test_judge",
      "repairer",
      "judge",
      "aggregator",
      "policy_executor"
    ],
    "required_pair_boundaries": [
      "generator_critic",
      "generator_repairer",
      "diagnostic_repairer",
      "generator_judge",
      "repairer_judge",
      "judge_aggregator",
      "critic_judge",
      "preference_judge_audit_judge"
    ],
    "accepted_mechanisms": [
      "separate_context",
      "separate_prompt",
      "fresh_seed",
      "blinded_candidate_identity",
      "no_shared_scratchpad"
    ],
    "same_model_weights_allowed": true,
    "origin_diversity_preferred": true
  },
  "verification_protocol": {
    "pairwise_blind_comparison": true,
    "orders": [
      "AB",
      "BA"
    ],
    "reset_context_between_orders": true,
    "counterfactual_suite_required": true,
    "regression_suite_required": true,
    "evidence_trace_required": true,
    "challenge_round_required": true,
    "promotion_artifact_binding_required": true,
    "frozen_evaluation_manifest_required": true,
    "exact_manifest_coverage_required": true,
    "experiment_ledger_required": true,
    "inconclusive_is_not_promotion": true
  },
  "promotion_lifecycle": {
    "states": [
      "generated",
      "diagnosed",
      "challenged",
      "repair_proposed",
      "verifying",
      "probation",
      "promoted",
      "rejected",
      "quarantined",
      "deprecated",
      "rolled_back"
    ],
    "hard_gates": [
      "schema_bundle_valid",
      "provenance_verified",
      "trust_root_pinned",
      "taxonomy_authority_pinned",
      "run_attestation_verified",
      "source_records_content_addressed",
      "actor_profiles_bound",
      "target_failure_reduced",
      "aggregation_recomputed",
      "generator_not_judge",
      "order_swap_complete",
      "independent_judges_met",
      "evidence_coverage_met",
      "counterfactual_pass_rate_met",
      "regression_failure_rate_met",
      "repeat_runs_met",
      "no_unresolved_blocking_challenges",
      "candidate_wins",
      "policy_digest_bound",
      "promotion_artifact_bound",
      "evaluation_manifest_complete",
      "experiment_budget_respected",
      "taxonomy_test_recipe_replayed",
      "scene_contract_grounded",
      "generation_request_precommitted",
      "diagnostic_request_precommitted",
      "repair_request_precommitted",
      "verification_request_precommitted",
      "repair_targets_evidence_bound",
      "actor_ids_unique",
      "preference_audit_channels_isolated",
      "target_judge_cartesian_coverage",
      "critic_handoff_complete",
      "receipt_timeline_valid",
      "blinding_mapping_committed",
      "repeat_contexts_isolated",
      "repair_edits_replayed",
      "preservation_checks_bound",
      "stop_rule_trigger_consistent",
      "target_turn_bound",
      "cross_stage_actor_isolation",
      "taxonomy_semantics_valid",
      "regression_registry_pinned",
      "preference_requests_bound",
      "challenge_invocations_bound",
      "counterfactual_sources_bound",
      "evidence_support_set_complete",
      "verification_suites_bound",
      "structural_input_limits_enforced",
      "audit_requests_bound",
      "lifecycle_graph_frozen",
      "model_call_lower_bound_enforced",
      "verification_timestamps_ordered",
      "challenge_requests_bound",
      "challenge_resolution_checks_exact",
      "case_scoped_promotion_only",
      "model_call_ledger_cumulative"
    ],
    "transitions": [
      {
        "from": "generated",
        "to": "diagnosed",
        "condition_code": "diagnostic_bundle_valid"
      },
      {
        "from": "generated",
        "to": "quarantined",
        "condition_code": "diagnostic_bundle_invalid"
      },
      {
        "from": "diagnosed",
        "to": "challenged",
        "condition_code": "diagnostic_challenge_required"
      },
      {
        "from": "diagnosed",
