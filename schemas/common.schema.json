{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuqing-cai.github.io/cn-failure-atlas/schemas/common.schema.json",
  "title": "Machine evolution record common definitions",
  "description": "Shared primitives for machine-generated diagnostic, repair, verification, and evolution-policy records.",
  "$defs": {
    "mode": {
      "type": "string",
      "enum": ["machine_only", "hybrid"],
      "default": "machine_only",
      "description": "Execution mode. Omission does not insert a value; record schemas require this field and examples use machine_only."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uriReference": {
      "type": "string",
      "minLength": 1
    },
    "actorOrigin": {
      "type": "object",
      "required": ["provider", "model", "model_version"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "model": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "model_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "deployment": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "weights_digest": { "$ref": "#/$defs/sha256" },
        "endpoint_class": {
          "type": "string",
          "enum": ["hosted", "local", "unknown"],
          "default": "unknown"
        }
      }
    },
    "canonicalActor": {
      "type": "object",
      "required": ["id", "origin"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "origin": { "$ref": "#/$defs/actorOrigin" }
      }
    },
    "machineActor": {
      "type": "object",
      "required": ["id", "origin", "kind", "role", "prompt", "context_partition"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "origin": { "$ref": "#/$defs/actorOrigin" },
        "kind": { "const": "machine" },
        "role": {
          "type": "string",
          "enum": ["generator", "contract_critic", "critic", "test_judge", "repairer", "judge", "aggregator", "policy_executor"]
        },
        "prompt": {
          "type": "object",
          "required": ["bundle_id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "bundle_id": { "$ref": "#/$defs/id" },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "context_partition": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "actorRef": {
      "type": "object",
      "required": ["actor_id"],
      "additionalProperties": false,
      "properties": {
        "actor_id": { "$ref": "#/$defs/id" }
      }
    },
    "isolationPair": {
      "type": "object",
      "required": ["left_actor_id", "right_actor_id", "mechanisms", "independent_context", "verified"],
      "additionalProperties": false,
      "properties": {
        "left_actor_id": { "$ref": "#/$defs/id" },
        "right_actor_id": { "$ref": "#/$defs/id" },
        "mechanisms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "separate_context",
              "separate_prompt",
              "separate_model",
              "separate_provider",
              "fresh_seed",
              "blinded_candidate_identity",
              "no_shared_scratchpad"
            ]
          }
        },
        "independent_context": { "const": true },
        "verified": { "const": true },
        "verification_note": { "type": "string", "minLength": 1 }
      }
    },
    "identityIsolation": {
      "type": "object",
      "required": ["pairs", "no_shared_scratchpad", "role_prompts_separated"],
      "additionalProperties": false,
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/isolationPair" }
        },
        "no_shared_scratchpad": { "const": true },
        "role_prompts_separated": { "const": true },
        "same_weights_allowed": {
          "type": "boolean",
          "default": true,
          "description": "Logical identity isolation does not require different model weights."
        }
      }
    },
    "recordRef": {
      "type": "object",
      "required": ["record_id", "schema_id", "schema_version", "uri"],
      "additionalProperties": false,
      "properties": {
        "record_id": { "$ref": "#/$defs/id" },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "uri": { "$ref": "#/$defs/uriReference" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "contentAddressedRecordRef": {
      "type": "object",
      "required": ["record_id", "schema_id", "schema_version", "uri", "digest"],
      "additionalProperties": false,
      "properties": {
        "record_id": { "$ref": "#/$defs/id" },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "uri": { "$ref": "#/$defs/uriReference" },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "description": "A reference bound by SHA-256 to the RFC 8785 canonicalized complete JSON value of the referenced record."
    },
    "policyRef": {
      "type": "object",
      "required": ["record_id", "policy_version", "schema_id", "schema_version", "uri", "digest"],
      "additionalProperties": false,
      "properties": {
        "record_id": { "$ref": "#/$defs/id" },
        "policy_version": { "type": "string", "minLength": 1 },
        "schema_id": { "const": "https://yuqing-cai.github.io/cn-failure-atlas/schemas/evolution-policy.schema.json" },
        "schema_version": { "const": "2.0.0-alpha.1" },
        "uri": { "$ref": "#/$defs/uriReference" },
        "digest": {
          "$ref": "#/$defs/sha256",
          "description": "Must equal the referenced policy record's policy_digest."
        }
      }
    },
    "experimentLedger": {
      "type": "object",
      "required": ["family_id", "attempt_id", "attempt_index", "budget", "stop_rule"],
      "additionalProperties": false,
      "properties": {
        "family_id": {
          "$ref": "#/$defs/id",
          "description": "Stable identifier shared by every candidate attempt addressing the same experimental question."
        },
        "attempt_id": { "$ref": "#/$defs/id" },
        "attempt_index": { "type": "integer", "minimum": 1 },
        "budget": {
          "type": "object",
          "required": ["max_candidate_attempts", "candidate_attempts_used", "max_model_calls", "model_calls_used"],
          "additionalProperties": false,
          "properties": {
            "max_candidate_attempts": { "type": "integer", "minimum": 1 },
            "candidate_attempts_used": { "type": "integer", "minimum": 0 },
            "max_model_calls": { "type": "integer", "minimum": 1 },
            "model_calls_used": { "type": "integer", "minimum": 0 }
          },
          "description": "Precommitted search budget. Semantic validation must reject used values greater than their maxima."
        },
        "stop_rule": {
          "type": "object",
          "required": ["rule_id", "precommitted", "condition_code", "condition", "action_when_met", "action_on_budget_exhaustion", "triggered", "triggered_by"],
          "additionalProperties": false,
          "properties": {
            "rule_id": { "$ref": "#/$defs/id" },
            "precommitted": { "const": true },
            "condition_code": {
              "const": "first_critic_approval_or_budget_exhaustion",
              "description": "Executable condition: stop search at the first critic-approved candidate; budget exhaustion is a non-promoting stop."
            },
            "condition": { "type": "string", "minLength": 1 },
            "action_when_met": {
              "const": "halt_and_verify"
            },
            "action_on_budget_exhaustion": { "const": "halt_without_promotion" },
            "triggered": { "type": "boolean" },
            "triggered_by": {
              "type": "string",
              "enum": ["not_triggered", "critic_approval", "budget_exhaustion"]
            }
          },
          "oneOf": [
            {
              "properties": {
                "triggered": { "const": false },
                "triggered_by": { "const": "not_triggered" }
              }
            },
            {
              "properties": {
                "triggered": { "const": true },
                "triggered_by": { "enum": ["critic_approval", "budget_exhaustion"] }
              }
            }
          ]
        }
      }
    },
    "versionProvenance": {
      "type": "object",
      "required": ["taxonomy", "schema", "runner", "prompt_bundle", "digest_status", "created_at"],
      "additionalProperties": false,
      "properties": {
        "taxonomy": {
          "type": "object",
          "required": ["name", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" },
            "uri": { "$ref": "#/$defs/uriReference" }
          }
        },
        "schema": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "runner": {
          "type": "object",
          "required": ["name", "version", "commit"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" }
          }
        },
        "prompt_bundle": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "digest_status": {
          "type": "string",
          "enum": ["verified", "example_placeholder"],
          "description": "Whether every digest in this provenance object was computed from the named artifact. example_placeholder is allowed only for illustrative fixtures."
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "span": {
      "type": "object",
      "required": ["start", "end", "unit"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "unit": {
          "const": "unicode_codepoint",
          "description": "Zero-based half-open offsets into the exact source turn content; semantic validation must also require end > start and content.slice(start, end) === quote."
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "source_record_id", "turn_id", "span", "quote", "stance", "rationale"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "source_record_id": { "$ref": "#/$defs/id" },
        "turn_id": { "$ref": "#/$defs/id" },
        "candidate_id": { "$ref": "#/$defs/id" },
        "span": { "$ref": "#/$defs/span" },
        "quote": { "type": "string", "minLength": 1 },
        "stance": { "type": "string", "enum": ["supports", "refutes", "context"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "humanReview": {
      "type": "object",
      "description": "Entirely optional metadata for later calibration; never a machine-only gate.",
      "additionalProperties": false,
      "properties": {
        "reviewer_id": { "$ref": "#/$defs/id" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "decision": { "type": "string", "enum": ["accept", "reject", "amend"] },
        "note": { "type": "string" }
      }
    }
  }
}
