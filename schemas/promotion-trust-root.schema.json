{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuqing-cai.github.io/cn-failure-atlas/schemas/promotion-trust-root.schema.json",
  "title": "Promotion policy trust root",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "trust_root_id",
    "policy_id",
    "policy_version",
    "policy_digest",
    "taxonomy_name",
    "taxonomy_version",
    "taxonomy_digest",
    "trusted_runners",
    "trusted_prompt_bundles",
    "trusted_regression_suites",
    "receipt_public_keys",
    "immutable",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "record_type": { "const": "promotion_trust_root" },
    "schema_version": { "const": "1.0.0" },
    "trust_root_id": { "$ref": "common.schema.json#/$defs/id" },
    "policy_id": { "$ref": "common.schema.json#/$defs/id" },
    "policy_version": { "type": "string", "minLength": 1 },
    "policy_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "taxonomy_name": { "type": "string", "minLength": 1 },
    "taxonomy_version": { "type": "string", "minLength": 1 },
    "taxonomy_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "trusted_runners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "version", "commit"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trusted_prompt_bundles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version", "digest"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "version": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "trusted_regression_suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["suite_id", "suite_version", "suite_digest", "suite_uri", "digest_rule", "cases"],
        "additionalProperties": false,
        "properties": {
          "suite_id": { "$ref": "common.schema.json#/$defs/id" },
          "suite_version": { "type": "string", "minLength": 1 },
          "suite_digest": { "$ref": "common.schema.json#/$defs/sha256" },
          "suite_uri": { "type": "string", "format": "uri-reference", "minLength": 1 },
          "digest_rule": { "const": "sha256_rfc8785_json" },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["case_id", "case_digest", "case_uri", "digest_rule", "required_for_promotion", "failure_policy"],
              "additionalProperties": false,
              "properties": {
                "case_id": { "$ref": "common.schema.json#/$defs/id" },
                "case_digest": { "$ref": "common.schema.json#/$defs/sha256" },
                "case_uri": { "type": "string", "format": "uri-reference", "minLength": 1 },
                "digest_rule": { "const": "sha256_rfc8785_json" },
                "required_for_promotion": {
                  "type": "boolean",
                  "description": "When true, at least one regression check must execute this exact registered case before promotion."
                },
                "failure_policy": { "const": "hard_veto" }
              }
            }
          }
        }
      },
      "description": "Externally anchored content addresses for regression suite manifests and cases. The Gate matches identities and digests only; a resolver must fetch, hash, and execute the referenced bytes."
    },
    "receipt_public_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["key_id", "issuer_id", "algorithm", "public_key_pem"],
        "additionalProperties": false,
        "properties": {
          "key_id": { "$ref": "common.schema.json#/$defs/id" },
          "issuer_id": { "$ref": "common.schema.json#/$defs/id" },
          "algorithm": { "const": "Ed25519" },
          "public_key_pem": { "type": "string", "minLength": 1 }
        }
      }
    },
    "immutable": { "const": true },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "description": "Bootstrap configuration pinned outside the candidate-writable evidence bundle. A policy cannot authorize itself merely by recomputing its own digest."
}
